# Eidolon Assistant API keys.
#
# Copy this file to config/local.env and fill in the values:
#   cp config/local.env.example config/local.env
#   chmod 600 config/local.env
#
# config/local.env is gitignored. Never commit real keys.

# Chat LLM: DeepSeek (or any OpenAI-compatible endpoint).
CHAT_LLM_BASE_URL=https://api.deepseek.com/v1
CHAT_LLM_MODEL=deepseek-chat
CHAT_LLM_API_KEY=

# Alibaba Cloud Bailian / DashScope realtime speech recognition.
DASHSCOPE_API_KEY=

# Fish Audio text-to-speech.
FISH_AUDIO_API_KEY=

# Optional: override the DeepSeek Harness CLI path (default below).
# EIDOLON_DSH_COMMAND=/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh
